{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.dev/danse/installation/release-manifest.schema.json",
  "title": "Danse canonical installation release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec_contract_sha256", "files"],
  "properties": {
    "schema": {"const": "danse.installation.release.v1"},
    "spec_contract_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "executable"],
        "properties": {
          "path": {"$ref": "#/$defs/relative_path"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "executable": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+$"
    }
  }
}
