{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.dev/danse/installation/digital-twin.schema.json",
  "title": "Danse deterministic reference installation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "source_contracts",
    "coordinate_system",
    "projector_camera",
    "surfaces",
    "projection_outputs",
    "synchronization",
    "audio",
    "calibration",
    "hardware_roles",
    "runtime",
    "release"
  ],
  "properties": {
    "schema": {"const": "danse.installation.digital-twin.v1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "contract_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"const": "reference-simulation"},
        "contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_contracts": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"$ref": "#/$defs/relative_path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "embedded_schema": {"type": "string", "minLength": 1},
          "embedded_contract_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "coordinate_system": {"$ref": "#/$defs/object"},
    "projector_camera": {"$ref": "#/$defs/object"},
    "surfaces": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/object"}},
    "projection_outputs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/object"}},
    "synchronization": {"$ref": "#/$defs/object"},
    "audio": {"$ref": "#/$defs/object"},
    "calibration": {"$ref": "#/$defs/object"},
    "hardware_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "runtime": {"$ref": "#/$defs/object"},
    "release": {"$ref": "#/$defs/object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+$"
    },
    "object": {"type": "object", "minProperties": 1}
  }
}
