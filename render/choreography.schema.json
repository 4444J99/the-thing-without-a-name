{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danse.example/schemas/choreography.v1.json",
  "title": "Danse score-led choreography",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "legibility", "motifs", "phrase_assignments"],
  "properties": {
    "schema": {"const": "danse.choreography.v1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score_contract_sha256",
        "score_file_sha256",
        "corpus_manifest_sha256",
        "corpus_score_sha256",
        "contract_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "score_contract_sha256": {"$ref": "#/$defs/sha256"},
        "score_file_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_score_sha256": {"$ref": "#/$defs/sha256"},
        "contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "legibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_pose_dwell_bars",
        "minimum_pose_transition_bars",
        "minimum_topology_transition_bars",
        "maximum_fragment_change_area_per_bar",
        "fragment_counterpoint_fraction",
        "hard_global_recast_before_signature",
        "frame_order_semantics"
      ],
      "properties": {
        "minimum_pose_dwell_bars": {"type": "number", "minimum": 2},
        "minimum_pose_transition_bars": {"type": "number", "minimum": 1},
        "minimum_topology_transition_bars": {"type": "number", "minimum": 1},
        "maximum_fragment_change_area_per_bar": {"type": "number", "minimum": 0, "maximum": 0.25},
        "fragment_counterpoint_fraction": {"const": 0},
        "hard_global_recast_before_signature": {"const": false},
        "frame_order_semantics": {"const": "authored-motif-not-chronology"}
      }
    },
    "motifs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_frame_ids", "geometry_frame_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_frame_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "geometry_frame_id": {"type": ["string", "null"]}
        }
      }
    },
    "phrase_assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phrase_id",
          "movement_id",
          "motif_id",
          "cut_mode",
          "pose_dwell_bars",
          "pose_transition_bars",
          "topology_transition_bars",
          "hold_complete_phrase"
        ],
        "properties": {
          "phrase_id": {"type": "string", "minLength": 1},
          "movement_id": {"enum": ["ONE", "ASSEMBLY", "DIVISION", "PHRASE", "STILLNESS", "RESEED", "SIGNATURE"]},
          "motif_id": {"type": ["string", "null"]},
          "cut_mode": {"enum": ["solo", "score", "grid", "bands", "figure", "black"]},
          "pose_dwell_bars": {"type": "number", "minimum": 2},
          "pose_transition_bars": {"type": "number", "minimum": 1},
          "topology_transition_bars": {"type": "number", "minimum": 1},
          "hold_complete_phrase": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
